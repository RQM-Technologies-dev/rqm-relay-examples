{
  "name": "rqm-jobs-desktop-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.mjs",
    "check": "npm test && npm run build && mcpb validate dist/manifest.json && npm audit --audit-level=high",
    "pack": "npm run check && mcpb pack dist rqm-jobs-discovery.mcpb",
    "probe:live": "node probe-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
