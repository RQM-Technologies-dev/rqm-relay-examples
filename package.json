{
  "name": "rqm-relay-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone x402 buyer and durable recovery examples for RQM Relay",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "preflight": "tsx src/preflight.ts",
    "purchase": "tsx src/purchase.ts purchase",
    "recover": "tsx src/purchase.ts recover",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@x402/core": "2.7.0",
    "@x402/evm": "2.7.0",
    "@x402/fetch": "2.7.0",
    "viem": "2.47.4",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
